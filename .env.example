# Copie este arquivo para .env e preencha os valores do ambiente.
# O .env deve permanecer fora do versionamento.

DBKADE_DEV_USER=root
DBKADE_DEV_PASSWORD=
DBKADE_DEV_HOST=localhost
DBKADE_DEV_DATABASE=kadecaminh
DBKADE_DEV_PORT=3306

DBCEP_DEV_USER=root
DBCEP_DEV_PASSWORD=
DBCEP_DEV_HOST=localhost
DBCEP_DEV_DATABASE=kadecaminh_1
DBCEP_DEV_PORT=3306

DBKADE_PRD_USER=
DBKADE_PRD_PASSWORD=
DBKADE_PRD_HOST=
DBKADE_PRD_DATABASE=
DBKADE_PRD_PORT=3306

DBCEP_PRD_USER=
DBCEP_PRD_PASSWORD=
DBCEP_PRD_HOST=
DBCEP_PRD_DATABASE=
DBCEP_PRD_PORT=3306

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_AUTH=true
# Remetente dos e-mails (do mesmo domínio do SMTP). Ex.: contato@kadecaminhoes.com.br
SMTP_FROM=contato@kadecaminhoes.com.br
# Local (Laragon): use o Mailpit com SMTP_HOST=127.0.0.1, SMTP_PORT=1025 e SMTP_USER vazio;
# os e-mails aparecem em http://localhost:8025

# URL pública do site, usada nos links dos e-mails (confirmação de cadastro, nova senha).
# Em produção, defina sempre. Ex.: https://www.kadecaminhoes.com.br
APP_URL=http://kade.test
