# Copie este arquivo para .env e preencha os valores do ambiente.
# O .env deve permanecer fora do versionamento.

DBKADE_DEV_USER=root
DBKADE_DEV_PASSWORD=
DBKADE_DEV_HOST=localhost
DBKADE_DEV_DATABASE=kadecaminh
DBKADE_DEV_PORT=3306

# Banco de CEP antigo (procedure procurar_cep). OPCIONAL: a busca de CEP usa o cache
# local (tabela cep_cache), o ViaCEP e a BrasilAPI. Preencha só se ainda tiver esse banco.
DBCEP_DEV_USER=
DBCEP_DEV_PASSWORD=
DBCEP_DEV_HOST=
DBCEP_DEV_DATABASE=
DBCEP_DEV_PORT=3306

DBKADE_PRD_USER=
DBKADE_PRD_PASSWORD=
DBKADE_PRD_HOST=
DBKADE_PRD_DATABASE=
DBKADE_PRD_PORT=3306

DBCEP_PRD_USER=
DBCEP_PRD_PASSWORD=
DBCEP_PRD_HOST=
DBCEP_PRD_DATABASE=
DBCEP_PRD_PORT=3306

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_AUTH=true
# Remetente dos e-mails (do mesmo domínio do SMTP). Ex.: contato@kadecaminhoes.com.br
SMTP_FROM=contato@kadecaminhoes.com.br
# Local (Laragon): use o Mailpit com SMTP_HOST=127.0.0.1, SMTP_PORT=1025 e SMTP_USER vazio;
# os e-mails aparecem em http://localhost:8025

# URL pública do site, usada nos links dos e-mails (confirmação de cadastro, nova senha).
# Em produção, defina sempre. Ex.: https://www.kadecaminhoes.com.br
# Também monta os endereços do /sitemap.xml.
APP_URL=http://kade.test

# Gateway de SMS. SMS_GATEWAY_IP: IP(s) aceitos, separados por vírgula (sem a variável,
# vale 200.195.184.186). SMS_TOKEN: segredo que o gateway põe na URL
# /RegisterVehicleSMS.ctrlExt/<SMS_TOKEN>/<telefone>/<mensagem> (16 a 128 caracteres:
# letras, números, _ ou -). Em produção, defina o SMS_TOKEN.
#SMS_GATEWAY_IP=200.195.184.186
SMS_TOKEN=

# Números do mapa da home: real (veículos ativos, padrão) ou ilustrativa (qty_illus,
# o número inflado que o site antigo mostrava)
MAPA_CONTAGEM=real

# WhatsApp (Cloud API da Meta), webhook /webhook/whatsapp. Passo a passo no README
# ("WhatsApp e Telegram"). Sem WHATSAPP_APP_SECRET o canal fica desligado; sem
# WHATSAPP_TOKEN o veículo é cadastrado, mas o motorista não recebe resposta.
# WHATSAPP_NUMBER (DDI + DDD + número) mostra o botão "WhatsApp" no site.
# Local: valores quaisquer nos dois primeiros para os testes HTTP dos webhooks.
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
#WHATSAPP_API_VERSION=v23.0
WHATSAPP_NUMBER=

# Telegram, webhook /webhook/telegram: o segredo informado no setWebhook (letras,
# números, _ ou -) e o nome do robô, que mostra o botão "Telegram" no site.
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_BOT=
