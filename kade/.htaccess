Header unset Pragma
FileETag None
Header unset ETag

# Proteções do navegador: o site não pode ser embutido em iframe de outro domínio
# (clickjacking na tela de login), o navegador não "adivinha" tipos de arquivo, a URL
# completa não vaza para outros sites e a versão do PHP não é anunciada.
# HSTS só quando a página vem por HTTPS.
Header always set X-Frame-Options "SAMEORIGIN"
Header always set X-Content-Type-Options "nosniff"
Header always set Referrer-Policy "strict-origin-when-cross-origin"
Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
Header always set Strict-Transport-Security "max-age=31536000" env=HTTPS
Header unset X-Powered-By
Header always unset X-Powered-By

# This legacy application uses PHP short opening tags in its views.
php_flag short_open_tag on
php_value default_charset "UTF-8"
AddDefaultCharset UTF-8

# cache images/pdf docs for 10 days
<FilesMatch "\.(ico|pdf|jpg|jpeg|png|gif|js|css)$">
Header set Cache-Control "max-age=864000, public, must-revalidate"
</FilesMatch>

# cache html/htm/xml/txt files for 2 hours
<FilesMatch "\.(html|htm|xml|txt|xsl)$">
Header set Cache-Control "max-age=7200, must-revalidate"
</FilesMatch>

# compress text, html, javascript, css, xml:
# AddOutputFilterByType DEFLATE text/plain
# AddOutputFilterByType DEFLATE text/html
# AddOutputFilterByType DEFLATE text/xml
# AddOutputFilterByType DEFLATE text/css
# AddOutputFilterByType DEFLATE application/xml
# AddOutputFilterByType DEFLATE application/xhtml+xml
# AddOutputFilterByType DEFLATE application/rss+xml
# AddOutputFilterByType DEFLATE application/javascript
# AddOutputFilterByType DEFLATE application/x-javascript
# AddOutputFilterByType DEFLATE text/javascript

#Image Expires Tag Test
<IfModule mod_expires.c>
    ExpiresActive on

    ExpiresByType image/jpg "access plus 1 month"
    ExpiresByType image/jpeg "access plus 1 month"
    ExpiresByType image/gif "access plus 1 month"
    ExpiresByType image/png "access plus 1 month"
</IfModule>

# php_value date.timezone 'America/Sao_Paulo'
# php_value session.auto_start 1
# php_value session.bug_compat_42 1
# php_value error_reporting 0

RewriteEngine On
Options -Indexes
ErrorDocument 403 /error.php
ErrorDocument 404 /error.php

# Nunca permita que um .env dentro da pasta pública seja baixado.
<FilesMatch "^\.env">
    Require all denied
</FilesMatch>

# Pastas que só o PHP usa não são servidas direto: views e parciais mostravam erro
# fatal com o caminho do servidor e der/ entregava o dump do banco. REDIRECT_STATUS
# vazio = requisição original; as rotas *.ctrlExt, reescritas internamente para
# shared/class/controller/, continuam funcionando.
RewriteCond %{ENV:REDIRECT_STATUS} ^$
RewriteRule ^(view|der|shared/class|shared/css/src)(/|$) - [R=404,L,NC]

# sitemap.xml é gerado com a URL pública do .env (APP_URL)
RewriteRule ^sitemap\.xml$ sitemap.php [L,NC]

# WhatsApp e Telegram chamam estes endereços a cada mensagem (webhooks). QSA: a
# verificação do WhatsApp vem na query string (hub.mode, hub.verify_token, hub.challenge)
RewriteRule ^webhook/(whatsapp|telegram)/?$ shared/class/controller/MessengerCtrl.class.php?action=$1 [L,NC,QSA]

# /shared/ só tem arquivos: um arquivo ausente ali vira 404 (antes renderizava a home inteira)
RewriteCond %{REQUEST_URI} !^/shared/
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^([^/\.]+)(\/(.*))?$ index.php?page=$1&$3 [NC]
# SMS: /RegisterVehicleSMS.ctrlExt/[<token>/]<telefone>/<tipo*cep> (o token é o SMS_TOKEN do .env)
RewriteRule ^RegisterVehicleSMS.ctrlExt\/([0-9]+)\/([0-9*]+)$ shared/class/controller/VehicleRegCtrl.class.php?action=saveSMS&from=$1&body=$2 [NC]
RewriteRule ^RegisterVehicleSMS.ctrlExt\/([A-Za-z0-9_-]{16,128})\/([0-9]+)\/([0-9*]+)$ shared/class/controller/VehicleRegCtrl.class.php?action=saveSMS&token=$1&from=$2&body=$3 [NC]
RewriteRule ^(.+)\.ctrlExt\/(.+)$ shared/class/controller/$1.class.php?action=$2 [NC]
