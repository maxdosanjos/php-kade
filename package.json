{
  "name": "php-kade",
  "private": true,
  "description": "Build do CSS (Tailwind) das views do KADE Caminhões",
  "scripts": {
    "build:css": "tailwindcss -i kade/shared/css/src/app.css -o kade/shared/css/app.css --minify",
